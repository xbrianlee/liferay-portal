<definition>
	<command name="add">
		<execute function="Click" locator1="Button#PLUS" />

		<execute function="AssertTextEquals" locator1="Portlet#HEADER" value1="New Role" />

		<execute function="Type" locator1="TextInput#TITLE" value1="${roleTitle}" />

		<if>
			<isset var="roleDescription" />
			<then>
				<execute function="Type" locator1="TextArea#DESCRIPTION" value1="${roleDescription}" />
			</then>
		</if>

		<if>
			<isset var="roleKey" />
			<then>
				<execute function="Type" locator1="TextInput#KEY" value1="${roleKey}" />
			</then>
		</if>

		<execute function="AssertClick" locator1="Button#SUBMIT" value1="Save" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="addAssignees">
		<execute function="Click" locator1="Button#PLUS" />

		<execute function="SelectFrame" locator1="IFrame#SELECT_ASSIGNEES" />

		<execute macro="Search#searchCP">
			<var name="searchTerm" value="${assigneeName}" />
		</execute>

		<var name="key_assigneeName" value="${assigneeName}" />

		<execute function="AssertTextEquals" locator1="RolesAssignMembers#ADD_ASSIGNEE_TABLE_NAME" value1="${assigneeName}" />

		<execute function="Check" locator1="RolesAssignMembers#ADD_ASSIGNEE_TABLE_CHECKBOX" />

		<execute function="SelectFrameTop" value1="relative=top" />

		<execute function="AssertClick" locator1="Button#ADD" value1="Add" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="delete">
		<var name="key_itemName" value="${roleTitle}" />

		<execute function="Click" locator1="ListGroupItem#ITEM_ACTIONS" />

		<execute function="AssertClickNoError" locator1="MenuItem#DELETE" value1="Delete" />

		<execute function="Confirm" value1="Are you sure you want to delete this? It will be deleted immediately." />
	</command>

	<command name="deleteAssignees">
		<execute function="Check" locator1="RolesPermissions#ASSIGNEE_TABLE_CHECKBOX" />

		<execute macro="Button#clickDelete" />

		<execute macro="Alert#viewSuccessMessage" />
	</command>

	<command name="editDescription">
		<execute function="Type" locator1="TextArea#DESCRIPTION" value1="${roleDescription}" />

		<if>
			<equals arg1="${localizeRoleDescription}" arg2="true" />
			<then>
				<execute macro="Role#localize">
					<var name="localizedName" value="roleDescriptionLocalized" />
					<var name="localizeType" value="DESCRIPTION" />
				</execute>
			</then>
		</if>

		<execute macro="PortletEntry#save" />
	</command>

	<command name="editTitle">
		<execute function="Type" locator1="TextInput#TITLE" value1="${roleTitle}" />

		<if>
			<equals arg1="${localizeRoleName}" arg2="true" />
			<then>
				<execute macro="Role#localize">
					<var name="localizedName" value="${roleTitleLocalized}" />
					<var name="localizeType" value="TITLE" />					
				</execute>
			</then>
		</if>

		<execute macro="PortletEntry#save" />
	</command>

	<command name="localize">
		<if>
			<isset var="language" />
			<then>
				<var method="StringUtil#extractFirst('${language}', ' ')" name="language" />
				<var method="StringUtil#upperCase('${language}')" name="language" />

				<execute function="Click" locator1="RolesEditRole#${localizeType}_FIELD_LOCALIZATION_FLAG_${language}" />

				<execute function="Type" locator1="TextInput#${localizeType}" value1="${localizedName}" />
			</then>
		</if>
	</command>
</definition>