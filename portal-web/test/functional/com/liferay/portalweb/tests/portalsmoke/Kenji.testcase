@component-name = "portal-smoke"
definition {
	property testray.main.component.name = "Smoke";

	setUp {
		Open(locator1 = "http://www.google.com");
	}

	tearDown {
		Open(locator1 = "http://www.google.com");
	}

	@priority = "5"
	test LocalhostPort9201 {
		property portal.smoke="kenji";

		var curl = "http://localhost:9201/_tasks";

		var elasticsearchTasks = JSONCurlUtil.get("${curl}");

		echo("${elasticsearchTasks}");
	}

	@priority = "5"
	test HostnamePort9201 {
		property portal.smoke="kenji";

		var hostnameURL = PropsUtil.get("hostname.url");

		var curl = "${hostnameURL}:9201/_tasks";

		var elasticsearchTasks = JSONCurlUtil.get("${curl}");

		echo("${elasticsearchTasks}");
	}

	@priority = "5"
	test NodeNamePort9201 {
		property portal.smoke="kenji";

		var nodeName = PropsUtil.get("node.name");

		var curl = "http://${nodeName}:9201/_tasks";

		var elasticsearchTasks = JSONCurlUtil.get("${curl}");

		echo("${elasticsearchTasks}");
	}

	@priority = "5"
	test OSContainerNamePort9201 {
		property portal.smoke="kenji";

		var portalURL = PropsUtil.get("portal.url");

		var osContainerName = StringUtil.replace("${portalURL}", "8080", "9201");

		var curl = "${osContainerName}/_tasks";

		var elasticsearchTasks = JSONCurlUtil.get("${curl}");

		echo("${elasticsearchTasks}");
	}

}