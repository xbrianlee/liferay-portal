<definition component-name="portal-permissions">
	<property name="custom.properties" value="passwords.default.policy.change.required=false" />
	<property name="data.creator.includes" value="site-demo-data-creator-api,site-demo-data-creator-impl,users-admin-demo,users-admin-demo-data-creator-api,users-admin-demo-data-creator-impl,roles-admin-demo-data-creator-api,roles-admin-demo-data-creator-impl" />
	<property name="portal.release" value="true" />
	<property name="portal.upstream" value="true" />
	<property name="testray.main.component.name" value="Permissions" />

	<set-up>
		<execute macro="TestCase#setUpPortalInstance" />

		<execute macro="User#firstLoginPG">
			<var name="password" value="test" />
			<var name="userEmailAddress" value="bruno.admin@liferay.com" />
		</execute>
	</set-up>

	<tear-down>
		<var method="TestPropsUtil#get('test.portal.instance')" name="testPortalInstance" />

		<if>
			<equals arg1="${testPortalInstance}" arg2="true" />
			<then>
				<execute macro="PortalInstances#tearDownCP" />
			</then>
			<else>
				<execute macro="User#logoutAndLoginPG">
					<var name="userLoginEmailAddress" value="bruno.admin@liferay.com" />
					<var name="userLoginFullName" value="Bruno Admin" />
				</execute>

				<execute macro="UserGroup#tearDownCP" />

				<execute macro="User#tearDownCP" />

				<execute macro="Role#tearDownCP" />

				<execute macro="PortalSettings#tearDownCP" />
			</else>
		</if>
	</tear-down>

	<command name="AddUserGroupRegRole" priority="4">
		<execute macro="PermissionsDataCreators#setUpRegRoleLoginUserCP">
			<var name="roleTitle" value="Regrole Name" />
			<var name="userEmailAddress" value="userea@liferay.com" />
			<var name="userFirstName" value="userfn" />
			<var name="userLastName" value="userln" />
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginEmailAddress" value="bruno.admin@liferay.com" />
			<var name="userLoginFullName" value="Bruno Admin" />
			<var name="userScreenName" value="usersn" />
		</execute>

		<execute macro="PermissionsDataCreators#definePermissionViaJSONAPI">
			<var name="resourceAction" value="VIEW_CONTROL_PANEL" />
			<var name="resourceName" value="90" />
			<var name="roleTitle" value="Regrole Name" />
		</execute>

		<execute macro="PermissionsDataCreators#definePermissionViaJSONAPI">
			<var name="resourceAction" value="ACCESS_IN_CONTROL_PANEL" />
			<var name="resourceName" value="com_liferay_user_groups_admin_web_portlet_UserGroupsAdminPortlet" />
			<var name="roleTitle" value="Regrole Name" />
		</execute>

		<execute macro="User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="User Groups" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="NavBar#ADD" />

		<execute macro="PermissionsDataCreators#definePermissionViaJSONAPI">
			<var name="resourceAction" value="ADD_USER_GROUP" />
			<var name="resourceName" value="90" />
			<var name="roleTitle" value="Regrole Name" />
		</execute>

		<execute macro="PermissionsDataCreators#definePermissionViaJSONAPI">
			<var name="resourceAction" value="VIEW" />
			<var name="resourceName" value="com.liferay.portal.kernel.model.UserGroup" />
			<var name="roleTitle" value="Regrole Name" />
		</execute>

		<execute macro="User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="User Groups" />
		</execute>

		<execute macro="UserGroup#addCP">
			<var name="userGroupName" value="UG UserGroup Name" />
		</execute>

		<execute macro="PermissionsDataCreators#removePermissionViaAPI">
			<var name="resourceAction" value="ADD_USER_GROUP" />
			<var name="resourceName" value="90" />
			<var name="roleTitle" value="Regrole Name" />
		</execute>

		<execute macro="PermissionsDataCreators#removePermissionViaAPI">
			<var name="resourceAction" value="VIEW" />
			<var name="resourceName" value="com.liferay.portal.kernel.model.UserGroup" />
			<var name="roleTitle" value="Regrole Name" />
		</execute>

		<execute macro="User#logoutAndLoginPG">
			<var name="userLoginEmailAddress" value="userea@liferay.com" />
			<var name="userLoginFullName" value="userfn userln" />
		</execute>

		<execute macro="ProductMenu#gotoControlPanelUsers">
			<var name="portlet" value="User Groups" />
		</execute>

		<execute function="AssertElementNotPresent" locator1="NavBar#ADD" />
	</command>
</definition>